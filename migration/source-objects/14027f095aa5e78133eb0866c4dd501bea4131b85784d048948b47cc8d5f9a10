#!/usr/bin/env python3
"""Run the restored original NCC harness, preserving files, CLI and raw outputs."""
import json,shutil
from experiment import ROOT,Experiment,write,digest
from snapshot import capture
build=json.loads((ROOT/'migration/reports/rewrite-extension-builds.json').read_text())['ncc'];observed=capture();results={}
if any(digest(ROOT/n)!=sha for n,sha in build['dependencies'].items()):raise RuntimeError('stale NCC binary')
cases={'original':[],'changed-values':['-g','1.1','-o','7','-noise','1','-n','2'],'changed-template':['-tw','64','-th','48','-n','1'],'no-timing':['-n','0'],'repeat':['-n','3'],'constant-template':['-g','0','-o','13','-noise','0','-n','0'],'constant-image':['-n','0'],'constant-both':['-g','0','-o','13','-noise','0','-n','0']}
for case,args in cases.items():
 e=Experiment('R3','NPP/templateMatching::templateMatching.cpp','rocm',case=case,sources=[__file__]+[ROOT/n for n in build['dependencies']],parent=build['experiment_id']);write(e.path/'backend.observed.json',observed)
 src=e.path/'inputs';src.mkdir();image=src/'image.raw'
 if case in ['constant-image','constant-both']:image.write_bytes(bytes([13])*(2048*1024))
 else:shutil.copyfile(ROOT/'NPP/templateMatching/images/CircuitBoard_2048x1024_8u.raw',image)
 write(src/'manifest.json',dict(case=case,argv=args,files={'image.raw':dict(sha256=digest(image),bytes=image.stat().st_size)}))
 out=e.path/'outputs';out.mkdir();cwd=e.path/'work';cwd.mkdir();args=['-i',str(image)]+args
 rc=e.command([str(ROOT/build['binary'])]+args,'original-harness',timeout=300,cwd=cwd,env=dict(REWRITE_OUTPUT=str(out)))
 if (cwd/'match_result.pgm').exists():shutil.copyfile(cwd/'match_result.pgm',out/'match_result.pgm')
 write(out/'manifest.json',dict(files={p.name:dict(sha256=digest(p),bytes=p.stat().st_size) for p in out.iterdir() if p.is_file()}))
 r=dict(case=case,argv=args,return_code=rc,input_manifest_sha256=digest(src/'manifest.json'),output=str(out.relative_to(ROOT)),experiment_id=e.id,build=build)
 r['evidence']=e.finish('EXECUTED' if rc==0 else 'HARNESS_NONZERO',reason=None if rc==0 else 'Original harness may reject ambiguous templates; independent/native checks still required');results[case]=r;write(ROOT/'migration/reports/rewrite-ncc-rocm.json',results);print(case,rc,flush=True)
