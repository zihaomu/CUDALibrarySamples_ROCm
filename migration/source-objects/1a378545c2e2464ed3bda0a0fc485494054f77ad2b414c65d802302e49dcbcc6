 out=e.path/'outputs';rc=e.command([sys.executable,__file__,str(out),str(ROOT/b['library']),b['library_sha256']],'actual-default-changed-reused-concurrent-foreign-destroyed',timeout=180);r=dict(return_code=rc,outputs=str(out.relative_to(ROOT)),build=b,experiment_id=e.id);write(e.path/'run.json',r);r['evidence']=e.finish('EXECUTED' if not rc else 'RUNTIME_ERROR');write(ROOT/'migration/reports/image-contour-states.json',r);record('I2','Contour默认流/复用/改变输入/两并发实例/外设备与销毁流11实际case执行rc='+str(rc)+'；像素仅物理GPU1，GPU0仅建外设备流。',[r['evidence']]);print(rc,r['evidence']);return rc
