 from snapshot import capture
 b=json.loads((ROOT/'migration/reports/image-contour-build.json').read_text());e=Experiment('I2','Contour-real-state-streams-and-concurrent-instances','rocm-runtime',sources=[__file__,ROOT/'tools/moat/image_contour_runtime_common.py',ROOT/'tools/moat/image_contour_worker.py',ROOT/'migration/rewrite/image-contour-state-contract.json',*dependencies()],parent=b['experiment_id'])
