 cv::Mat after=detector.detect(roi);raw(output+"/after-errors.bin",after);bool same=cv::countNonZero(first!=after)==0;all&=same;log<<",{\"case\":\"after-errors\",\"passed\":"<<(same?"true":"false")<<"}]}\n";if(!log)throw std::runtime_error("check output");return all?0:1;
