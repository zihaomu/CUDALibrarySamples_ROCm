/* Independent CPU observation helper, never part of the GPU decode path. */
#include <stdio.h>
#include <stdlib.h>
#include <jpeglib.h>
int main(int argc,char**argv){
 if(argc!=4 || (argv[3][0]!='0' && argv[3][0]!='1') || argv[3][1]) return 2;
 FILE*in=fopen(argv[1],"rb");if(!in)return 3;
 struct jpeg_decompress_struct c;struct jpeg_error_mgr error;
 c.err=jpeg_std_error(&error);jpeg_create_decompress(&c);jpeg_stdio_src(&c,in);
 if(jpeg_read_header(&c,TRUE)!=JPEG_HEADER_OK)return 4;
 c.out_color_space=JCS_RGB;c.dct_method=JDCT_ISLOW;c.do_fancy_upsampling=argv[3][0]=='1';
 jpeg_start_decompress(&c);
 if(c.output_components!=3 || !c.output_width || !c.output_height)return 5;
 FILE*out=fopen(argv[2],"wb");if(!out)return 6;
 size_t pitch=(size_t)c.output_width*3;unsigned char*row=malloc(pitch);if(!row)return 7;
 while(c.output_scanline<c.output_height){JSAMPROW rows[1]={row};if(jpeg_read_scanlines(&c,rows,1)!=1)return 8;if(fwrite(row,1,pitch,out)!=pitch)return 9;}
 printf("{\"width\":%u,\"height\":%u,\"channels\":%d,\"fancy\":%d,\"IDCT\":\"ISLOW\"}\n",c.output_width,c.output_height,c.output_components,c.do_fancy_upsampling);
 free(row);jpeg_finish_decompress(&c);jpeg_destroy_decompress(&c);fclose(in);return fclose(out)?10:0;
}
