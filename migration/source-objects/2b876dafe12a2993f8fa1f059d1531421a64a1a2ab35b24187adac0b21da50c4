#include "canny_stages.h"
#include <hip/hip_runtime.h>
#include <climits>

namespace {
__device__ int bound(int value, int size) {
    return value < 0 ? 0 : (value >= size ? size - 1 : value);
}
__device__ uint16_t integer_root(unsigned value) {
    unsigned root = static_cast<unsigned>(__builtin_sqrtf(static_cast<float>(value)));
    // Integer correction makes the result independent of sqrt rounding.
    while ((root + 1) * (root + 1) <= value) ++root;
    while (root * root > value) --root;
    return static_cast<uint16_t>(root);
}
__global__ void sobel(const uint8_t* input, uint64_t pitch, int width, int height,
                      int channels, int16_t* dx, int16_t* dy, uint16_t* magnitude) {
    int index = blockIdx.x * blockDim.x + threadIdx.x;
    if (index >= width * height) return;
    int x = index % width, y = index / width;
    int best = -1, selected_x = 0, selected_y = 0;
    for (int channel = 0; channel < channels; ++channel) {
        int gx = 0, gy = 0;
        for (int j = -1; j <= 1; ++j) for (int i = -1; i <= 1; ++i) {
            int value = input[uint64_t(bound(y + j, height)) * pitch + bound(x + i, width) * channels + channel];
            gx += value * i * (j == 0 ? 2 : 1);
            gy += value * j * (i == 0 ? 2 : 1);
        }
        int norm = gx * gx + gy * gy;
        if (norm > best) { best = norm; selected_x = gx; selected_y = gy; }
    }
    dx[index] = static_cast<int16_t>(selected_x);
    dy[index] = static_cast<int16_t>(selected_y);
    magnitude[index] = integer_root(static_cast<unsigned>(best));
}
__global__ void suppress(const int16_t* dx, const int16_t* dy, const uint16_t* mag,
                         uint16_t* output, int width, int height) {
    int index = blockIdx.x * blockDim.x + threadIdx.x;
    if (index >= width * height) return;
    int x = index % width, y = index / width;
    int gx = dx[index], gy = dy[index], ax = gx < 0 ? -gx : gx, ay = gy < 0 ? -gy : gy;
    int ox = 1, oy = 0;
    if (ay * 32768 > ax * (13573 + 65536)) { ox = 0; oy = 1; }
    else if (!(ay * 32768 < ax * 13573)) oy = gx * gy >= 0 ? 1 : -1;
    uint16_t a = mag[bound(y - oy, height) * width + bound(x - ox, width)];
    uint16_t b = mag[bound(y + oy, height) * width + bound(x + ox, width)];
    output[index] = mag[index] >= a && mag[index] >= b ? mag[index] : 0;
}
}

extern "C" hipError_t rocm_image_canny_stages(const uint8_t* source, uint64_t pitch,
    int width, int height, int channels, int16_t* dx, int16_t* dy,
    uint16_t* magnitude, uint16_t* suppressed, hipStream_t stream) {
    if (!source || !dx || !dy || !magnitude || !suppressed || width <= 0 || height <= 0 ||
        width > 32768 || height > 32768 || (channels != 1 && channels != 3) ||
        pitch < uint64_t(width) * channels || pitch > UINT64_MAX / uint64_t(height) ||
        uint64_t(width) * height > INT_MAX - 255)
        return hipErrorInvalidValue;
    int blocks = (width * height + 255) / 256;
    sobel<<<blocks, 256, 0, stream>>>(source, pitch, width, height, channels, dx, dy, magnitude);
    hipError_t status = hipGetLastError();
    if (status != hipSuccess) return status;
    suppress<<<blocks, 256, 0, stream>>>(dx, dy, magnitude, suppressed, width, height);
    return hipGetLastError();
}
