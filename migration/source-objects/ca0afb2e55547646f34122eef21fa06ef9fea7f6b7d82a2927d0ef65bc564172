#pragma once
#include "batch12_dist.hpp"
namespace migration_dist {
__global__ void scatter_double12(const double*a,const int*idx,double*out,int n){int t=blockIdx.x*blockDim.x+threadIdx.x;if(t<n)out[idx[t]]=a[t];}
__global__ void geadd_double12(const double*a,double*c,const int*idx,int count,int m,int ar,int ia,int ja){int t=blockIdx.x*blockDim.x+threadIdx.x;if(t<count){int row=idx[t]%m,col=idx[t]/m;c[t]+=a[row+ia+(col+ja)*ar];}}
inline double value_double12(int i,int j,int salt){return double((i*17+j*13+salt)%31-15)/31;}
inline int main_double12(int argc,char**argv){MPI_Init(&argc,&argv);int rank,size;MPI_Comm_rank(MPI_COMM_WORLD,&rank);MPI_Comm_size(MPI_COMM_WORLD,&size);try{int devices;MB_CHECK(MB_RT(GetDeviceCount)(&devices));if(size!=2||devices<2)throw std::runtime_error("requires two ranks and distinct GPUs");MB_CHECK(MB_RT(SetDevice)(rank));ncclUniqueId id;if(!rank)MB_CHECK(ncclGetUniqueId(&id));MPI_Bcast(&id,sizeof(id),MPI_BYTE,0,MPI_COMM_WORLD);ncclComm_t comm;MB_CHECK(ncclCommInitRank(&comm,2,id,rank));const char*dir=std::getenv("MIGRATION_OUTPUT_DIR");if(!dir)throw std::runtime_error("evidence directory required");Context c{rank,2,rank,comm,dir};auto cas=selected_case();int m=10,n=10,block=2,p=cas=="boundary"?1:2,q=2/p,ia=2,ja=2;if(cas=="irregular"){m=13;n=11;block=3;}if(cas=="singular-or-empty"){m=1;n=1;}int ar=m+ia,ac=n+ja;auto ai=indices12(ar,ac,block,p,q,rank),ci=indices12(m,n,block,p,q,rank);std::vector<double>a(ai.size()),initial(ci.size());for(size_t t=0;t<ai.size();++t)a[t]=value_double12(ai[t]%ar,ai[t]/ar,cas=="changed-values"?9:3);for(size_t t=0;t<ci.size();++t)initial[t]=value_double12(ci[t]%m,ci[t]/m,7);Buffer<double>local(a),masked(std::vector<double>(ar*ac,0)),all(ar*ac),out(initial);Buffer<int>axi(ai),cxi(ci);if(!ai.empty()){scatter_double12<<<(ai.size()+255)/256,256>>>(local.p,axi.p,masked.p,ai.size());++c.kernels;}MB_CHECK(ncclAllReduce(masked.p,all.p,ar*ac,ncclDouble,ncclSum,comm,0));++c.ar;c.sync();int repeat=cas=="repeat"?3:1;for(int rep=0;rep<repeat;++rep){out.put(initial);if(!ci.empty()){geadd_double12<<<(ci.size()+255)/256,256>>>(all.p,out.p,cxi.p,ci.size(),m,ar,ia,ja);++c.kernels;}}c.sync();c.save("A_local",a);c.save("A_indices",ai);c.save("C_initial",initial);c.save("C_indices",ci);c.save("output",out.get());c.save("config",std::vector<int>{m,n,10,block,p,q,ar,ac,m,n,ia,ja,repeat});c.finish();MB_CHECK(ncclCommDestroy(comm));MPI_Finalize();return 0;}catch(const std::exception&e){std::cerr<<e.what()<<std::endl;MPI_Abort(MPI_COMM_WORLD,1);return 1;}}
}
