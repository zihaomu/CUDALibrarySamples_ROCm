// GPU format conversion, stable CSR order and diagonal counted once.
__global__ void symmetric_expand8(const int*r,const int*c,const float*v,int base,int*out_r,int*out_c,float*out_v){if(blockIdx.x||threadIdx.x)return;int cursor=0;out_r[0]=base;for(int row=0;row<4;++row){for(int col=0;col<4;++col){float value=0;bool found=false;for(int i=0;i<4;++i)for(int p=r[i]-base;p<r[i+1]-base;++p)if((i==row&&c[p]-base==col)||(i==col&&c[p]-base==row)){value=v[p];found=true;}if(found){out_c[cursor]=col+base;out_v[cursor++]=value;}}out_r[row+1]=cursor+base;}}
// Project device-HIP custom operators preserve the original NVRTC function bodies.
__device__ double custom_epilogue8(int row,double value,double even,double odd){return (row%2?odd:even)*value;}
__device__ float custom_add8(float a,float b){return a+b;}
__device__ float custom_mul8(float a,float b){return a*b;}
__device__ float custom_mm_epilogue8(float value,float old){return value*2.f+old;}
__global__ void spmvop8(const int*r,const int*c,const double*a,const double*x,const double*y,double*z,double even,double odd){int row=threadIdx.x;if(row>=4)return;double sum=0;for(int p=r[row];p<r[row+1];++p)sum+=a[p]*x[c[p]];z[row]=custom_epilogue8(row,sum+3*y[row],even,odd);}
__global__ void spmmop8(const int*r,const int*c,const float*a,const float*b,const float*initial,float*out){int t=threadIdx.x;if(t>=12)return;int row=t/3,col=t%3;float sum=0;for(int p=r[row];p<r[row+1];++p)sum=custom_add8(sum,custom_mul8(a[p],b[c[p]*3+col]));out[t]=custom_mm_epilogue8(sum,initial[t]);}
// Budget governs numeric accumulator storage, independent of caller input/output buffers.
__global__ void spgemm_tile8(const int*ar,const int*ac,const float*av,const int*br,const int*bc,const float*bv,int first,int count,float*scratch){int t=threadIdx.x;if(t>=count*4)return;int row=first+t/4,col=t%4;float sum=0;for(int p=ar[row];p<ar[row+1];++p)for(int q=br[ac[p]];q<br[ac[p]+1];++q)if(bc[q]==col)sum+=av[p]*bv[q];scratch[t]=sum;}
__global__ void spgemm_emit8(const float*scratch,int first,int count,const int*ar,const int*ac,const int*br,const int*bc,int*cr,int*cc,float*cv,int*used){if(threadIdx.x||blockIdx.x)return;int cursor=*used;for(int row=first;row<first+count;++row){for(int col=0;col<4;++col){bool present=false;for(int p=ar[row];p<ar[row+1];++p)for(int q=br[ac[p]];q<br[ac[p]+1];++q)present|=bc[q]==col;if(present){cc[cursor]=col;cv[cursor++]=scratch[(row-first)*4+col];}}cr[row+1]=cursor;}*used=cursor;}
