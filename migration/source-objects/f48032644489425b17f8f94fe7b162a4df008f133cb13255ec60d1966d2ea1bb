#!/usr/bin/env python3
"""Freeze original helper metadata/data, language differences and edge variants."""
import json,struct
from pathlib import Path
from experiment import ROOT,write,digest

def make(profile,case):
 kind=['dense_matrix_helpers','sparse_matrix_helpers','batch_sparse_matrix_helpers'].index(profile['kind'])+1;lang=profile['language'];batch=2 if kind==3 else 1;base=1 if kind==3 and lang!='cpp' else 0
 if case=='alternate-base' and kind!=1:base=1-base
 factor=3 if case=='changed-values' else 1;inplace=-1.*factor;loops=3 if case=='repeat' else 1
 path=ROOT/'tests/fixtures/rewrite-helpers'/lang/profile['kind']/case;path.mkdir(parents=True,exist_ok=True)
 rows=[6] if kind==1 else [5] if kind==2 else [5,6]
 if case=='irregular' and kind==1:rows=[7]
 objects=[];files={}
 def save(name,values,code):
  file=path/(name+'.bin');file.write_bytes(struct.pack('<'+str(len(values))+code,*values));files[file.name]=dict(sha256=digest(file),bytes=file.stat().st_size)
 for i,n in enumerate(rows):
  name='b'+str(i);nc=n//2 if kind==1 else n;ld=2*n+(1 if case=='irregular' else 0) if kind==1 else n
  if kind==1:
   v=[float(j+1)*factor for j in range(ld*nc)];replacement=v.copy();replacement[1]=-4.*factor;final=replacement.copy();nz=nz2=0
  elif kind==2:
   nz,nz2=9,5;v=[float(j*2)*factor for j in range(nz)];r=[0,2,4,6,8,9];c=[0,0,1,1,2,2,3,3,4] if lang=='cpp' else [0,1,1,2,2,3,3,4,4];r2=list(range(n+1));c2=list(range(n));replacement=[float(j*4)*factor for j in range(nz2)]+[-777.*factor]*(nz-nz2);replacement[1]=-4.*factor;final=replacement.copy()
   if lang=='cpp':final[:nz2]=[float(j*4)*factor for j in range(nz2)]
  else:
   if i==0:r=[0,2,4,6,7,8];c=[0,2,1,2,2,4,3,4];v=[4.,1.,3.,2.,5.,1.,1.,2.];r2=[0,2,4,5,6,7];c2=[0,2,1,2,2,3,4];fv=[4.,1.,3.,2.,5.,1.,2.];rhs=[7.,12.,25.,4.,13.]
   else:
    r=[0,2,4,7,8,10,11];c=[0,5,1,4,2,4,5,3,4,5,5] if lang=='cpp' else [0,5,1,4,2,4,3,5,4,5,5];v=[3.,1.,2.,1.,6.,2.,2.,5.,7.,3.,8.];r2=[0,2,4,6,7,9,10];c2=[0,5,1,4,2,4,3,4,5,5];fv=[3.,1.,2.,1.,6.,2.,5.,7.,3.,8.];rhs=[9.,9.,40.,20.,61.,70.]
   nz,nz2=len(v),len(fv);v=[a*factor for a in v];replacement=v.copy();replacement[0]=[-4.,-3.][i]*factor;final=replacement.copy();final[:nz2]=[a*factor for a in fv];rhs=[a*factor for a in rhs];rhs2=rhs.copy();rhs2[0]=[-2.,-5.][i]*factor
   save(name+'_B',rhs,'d');save(name+'_B_replacement',rhs2,'d')
  if kind!=1:
   save(name+'_rows',[x+base for x in r],'i');save(name+'_columns',[x+base for x in c],'i');save(name+'_new_rows',[x+base for x in r2],'i');save(name+'_new_columns',[x+base for x in c2],'i')
  save(name+'_values',v,'d');save(name+'_replacement',replacement,'d');save(name+'_final',final,'d');objects.append(dict(nrows=n,ncols=nc,nnz=nz,new_nnz=nz2,ld=ld))
 config=dict(kind=kind,batch=len(rows),base=base,loops=loops,inplace=inplace,objects=objects)
 text=f'{kind} {len(rows)} {base} {loops} {inplace}\n'+''.join(' '.join(str(o[k]) for k in ['nrows','ncols','nnz','new_nnz','ld'])+'\n' for o in objects)
 (path/'config.txt').write_text(text);write(path/'config.json',config)
 for name in ['config.txt','config.json']:
  file=path/name;files[name]=dict(sha256=digest(file),bytes=file.stat().st_size)
 write(path/'manifest.json',dict(kind='matrix-helpers',profile=profile['kind'],language=lang,case=case,config=config,files=files,scope='Original defined input and mutation contract. Originally uninitialized replacement padding is explicitly initialized for complete-byte observability; not a new numerical algorithm.'))
 return str(path.relative_to(ROOT))

def main():
 spec=ROOT/'migration/rewrite/helpers-benchmark.json';data=json.loads(spec.read_text())
 for p in data['helpers']:
  for case in p['cases']:make(p,case)
  target=ROOT/p['implementation'];target.parent.mkdir(parents=True,exist_ok=True);kind=['dense_matrix_helpers','sparse_matrix_helpers','batch_sparse_matrix_helpers'].index(p['kind'])+1
  if p['language']=='cpp':target.write_text('// SPDX-License-Identifier: Apache-2.0\n// Original contract: '+p['source']+'\nint mh_program(int);\nint main(){return mh_program('+str(kind)+');}\n')
  else:target.write_text('! SPDX-License-Identifier: Apache-2.0\n! Standard Fortran adaptation of '+p['source']+'\nprogram main\n use rewrite_helper_samples\n implicit none\n call run_helper('+str(kind)+')\nend program\n')
 print('Frozen',sum(len(p['cases']) for p in data['helpers']),'entry fixtures; nine actual language entrypoints')
if __name__=='__main__':main()
