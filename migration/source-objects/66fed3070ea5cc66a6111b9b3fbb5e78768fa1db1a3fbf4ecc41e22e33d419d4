def validate(run):
 spec=json.loads((ROOT/'migration/rewrite/canny-color-cpp-runtime.json').read_text());out=ROOT/run['outputs'];rows=json.loads((out/'checks.json').read_text())['checks'];expected,_=model(ROOT/run['fixture']);checks=[dict(check='actual-C++-process-success',passed=run['return_code']==0),coverage(rows,[dict(case=n) for n in spec['cases']]),file_set(out,['checks.json','noncontiguous.bin','after-errors.bin'])]
 for name in ['noncontiguous','after-errors']:checks.append(array_check(out/(name+'.bin'),expected,digest(out/(name+'.bin'))))
 for r in rows:
  checks.append(dict(check=r['case']+'/actual-expected-behavior',passed=r['passed'] is True))
  if r['case'] not in {'noncontiguous','after-errors'}:
   text=r.get('diagnostic','');token='Image size/type mismatch' if r['case'] in {'dimension-mismatch','type-mismatch'} else 'Invalid thresholds' if r['case'].startswith('invalid-') else 'invalid argument';checks.append(dict(check=r['case']+'/specific-diagnostic',passed=bool(text and token.lower() in text.lower())))
 return dict(status='PASSED' if checks and all(c['passed'] is True for c in checks) else 'FAILED',checks=checks,case_count=len(rows))

