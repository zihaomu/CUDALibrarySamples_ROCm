// Real native compression and sparse matmul on the HIP-pruned A, so valid
// nonunique pruning ties do not make an end-to-end byte equality claim.
#include "rewrite_runtime.hpp"
#include <cusparseLt.h>
using namespace rewrite;
int main(int argc,char**argv){try{if(argc!=2)throw std::runtime_error("kind required");bool advanced=std::string(argv[1])=="sparse24_advanced";Config cfg;int m=cfg.get("m"),n=cfg.get("n"),k=cfg.get("k"),batch=cfg.get("batch"),lda=cfg.get("lda"),ldb=cfg.get("ldb"),ldc=cfg.get("ldc");int64_t sa=cfg.get("stride_a"),sb=cfg.get("stride_b"),sc=cfg.get("stride_c");float alpha=cfg.get("alpha"),beta=cfg.get("beta"),threshold=cfg.get("relu_threshold"),upper=cfg.get("relu_upper");identity();auto a=read<__half>("A",batch*sa),b=read<__half>("B",batch*sb),c=read<__half>("C",batch*sc),bias=read<__half>("bias",m);Buffer<__half>da(a),db(b),dc(c),dd(c),di(bias);Buffer<int>valid(std::vector<int>{-1});cusparseLtHandle_t handle;cusparseLtMatDescriptor_t ma,mb,mc;cusparseLtMatmulDescriptor_t mm;cusparseLtMatmulAlgSelection_t algorithm;cusparseLtMatmulPlan_t plan;RW_CHECK(cusparseLtInit(&handle));RW_CHECK(cusparseLtStructuredDescriptorInit(&handle,&ma,m,k,lda,16,CUDA_R_16F,CUSPARSE_ORDER_ROW,CUSPARSELT_SPARSITY_50_PERCENT));RW_CHECK(cusparseLtDenseDescriptorInit(&handle,&mb,n,k,ldb,16,CUDA_R_16F,CUSPARSE_ORDER_ROW));RW_CHECK(cusparseLtDenseDescriptorInit(&handle,&mc,m,n,ldc,16,CUDA_R_16F,CUSPARSE_ORDER_ROW));for(auto*p:{&ma,&mb,&mc})RW_CHECK(cusparseLtMatDescSetAttribute(&handle,p,CUSPARSELT_MAT_NUM_BATCHES,&batch,sizeof(batch)));RW_CHECK(cusparseLtMatDescSetAttribute(&handle,&ma,CUSPARSELT_MAT_BATCH_STRIDE,&sa,sizeof(sa)));RW_CHECK(cusparseLtMatDescSetAttribute(&handle,&mb,CUSPARSELT_MAT_BATCH_STRIDE,&sb,sizeof(sb)));RW_CHECK(cusparseLtMatDescSetAttribute(&handle,&mc,CUSPARSELT_MAT_BATCH_STRIDE,&sc,sizeof(sc)));RW_CHECK(cusparseLtMatmulDescriptorInit(&handle,&mm,CUSPARSE_OPERATION_NON_TRANSPOSE,CUSPARSE_OPERATION_TRANSPOSE,&ma,&mb,&mc,&mc,CUSPARSE_COMPUTE_32F));
if(advanced){void*ap=da.p;RW_CHECK(cusparseLtMatmulDescSetAttribute(&handle,&mm,CUSPARSELT_MATMUL_SPARSE_MAT_POINTER,&ap,sizeof(ap)));int enabled=1;RW_CHECK(cusparseLtMatmulDescSetAttribute(&handle,&mm,CUSPARSELT_MATMUL_ACTIVATION_RELU,&enabled,sizeof(enabled)));RW_CHECK(cusparseLtMatmulDescSetAttribute(&handle,&mm,CUSPARSELT_MATMUL_ACTIVATION_RELU_THRESHOLD,&threshold,sizeof(threshold)));RW_CHECK(cusparseLtMatmulDescSetAttribute(&handle,&mm,CUSPARSELT_MATMUL_ACTIVATION_RELU_UPPERBOUND,&upper,sizeof(upper)));void*bp=di.p;RW_CHECK(cusparseLtMatmulDescSetAttribute(&handle,&mm,CUSPARSELT_MATMUL_BIAS_POINTER,&bp,sizeof(bp)));}
RW_CHECK(cusparseLtMatmulAlgSelectionInit(&handle,&algorithm,&mm,CUSPARSELT_MATMUL_ALG_DEFAULT));RW_CHECK(cusparseLtMatmulPlanInit(&handle,&plan,&mm,&algorithm));RW_CHECK(cusparseLtSpMMAPruneCheck(&handle,&mm,da.p,valid.p,nullptr));sync();if(valid.get()[0])throw std::runtime_error("HIP-pruned A rejected by native structure check");size_t packed_bytes=0,tmp_bytes=0;RW_CHECK(cusparseLtSpMMACompressedSize(&handle,&plan,&packed_bytes,&tmp_bytes));Buffer<uint8_t>packed(packed_bytes),tmp(tmp_bytes);RW_CHECK(cusparseLtSpMMACompress(&handle,&plan,da.p,packed.p,tmp.p,nullptr));sync();emit("A_pruned",da.get());if(cfg.get("search")){RW_CHECK(cusparseLtMatmulSearch(&handle,&plan,&alpha,packed.p,db.p,&beta,dc.p,dd.p,nullptr,nullptr,0));sync();}size_t workspace_bytes=0;RW_CHECK(cusparseLtMatmulGetWorkspace(&handle,&plan,&workspace_bytes));Buffer<uint8_t>workspace(workspace_bytes);RW_CHECK(cusparseLtMatmul(&handle,&plan,&alpha,packed.p,db.p,&beta,dc.p,dd.p,workspace.p,nullptr,0));sync();emit("D",dd.get());emit("A_after",da.get());emit("B_after",db.get());emit("C_after",dc.get());emit("bias_after",di.get());emit("native_prune_check",valid.get());emit("native_plan",std::vector<uint64_t>{packed_bytes,tmp_bytes,workspace_bytes});RW_CHECK(cusparseLtMatDescriptorDestroy(&ma));RW_CHECK(cusparseLtMatDescriptorDestroy(&mb));RW_CHECK(cusparseLtMatDescriptorDestroy(&mc));RW_CHECK(cusparseLtMatmulAlgSelectionDestroy(&algorithm));RW_CHECK(cusparseLtMatmulPlanDestroy(&plan));RW_CHECK(cusparseLtDestroy(&handle));return 0;}catch(const std::exception&e){std::cerr<<e.what()<<'\n';return 1;}}
