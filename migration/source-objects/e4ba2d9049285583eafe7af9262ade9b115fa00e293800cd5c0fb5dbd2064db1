 p=argparse.ArgumentParser();p.add_argument('--originals',action='store_true');a=p.parse_args();spec=json.loads((ROOT/'migration/rewrite/canny-color-profile.json').read_text());runs=json.loads((ROOT/('migration/reports/canny-color-originals.json' if a.originals else 'migration/reports/canny-color-rocm.json')).read_text());sources=[__file__,ROOT/'tools/moat/image_canny_stages_reference.py',ROOT/'tools/moat/image_validation.py',ROOT/'migration/rewrite/canny-color-profile.json'];e=Experiment('I1','C3-Canny-originals' if a.originals else 'C3-Canny-complete-masks','CPU-reference',sources=sources)
