def semantic(fixture,mask,info):
 c=json.loads((fixture/'config.json').read_text());h,w=c['height'],c['width'];kind=c['semantic'];checks=[dict(check='binary-and-weak-support',passed=bool(np.all((mask==0)|(mask==255)) and np.all((mask==0)|info['weak']))),dict(check='all-strong-seeds-retained',passed=bool(np.all(mask[info['strong']]==255)))]
