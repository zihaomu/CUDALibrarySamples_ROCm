def validate_masks(run,spec,natives,debug=None):
 checks=[dict(check='actual-process-success',passed=run['return_code']==0)];results=[]
 try:
  out=ROOT/run['outputs'];rows=json.loads((out/'results.json').read_text());checks.extend([coverage(rows,spec['cases']),coverage(natives,spec['cases'])]);by={r['case']:r for r in rows};native={r['case']:r for r in natives}
  for case in spec['cases']:
   name=case['case'];row=by[name];d=ROOT/case['fixture'];c=json.loads((d/'config.json').read_text());h,w=c['height'],c['width'];expected,info=model(d);own=[fixture_identity(d,case['manifest_sha256']),file_set(out/name,['pitched.bin','tensor.bin','numpy.bin']),dict(check='complete-output-manifest-and-identity',passed=set(row['files'])=={'pitched.bin','tensor.bin','numpy.bin'} and row['library_sha256']==run['build']['library_sha256'] and row['input_manifest_sha256']==case['manifest_sha256'] and row['width']==w and row['height']==h)];padded=np.full((h,c['output_pitch']),173,np.uint8);padded[:,:w]=expected
   for file,expected_array in [('pitched.bin',padded),('tensor.bin',expected),('numpy.bin',expected)]:
    own.append(dict(check=file+'/declared-bytes',passed=row['files'][file]['bytes']==expected_array.nbytes));own.append(array_check(out/name/file,expected_array,row['files'][file]['sha256']))
   own+=semantic(d,expected,info);cross,metrics=native_comparison(native[name],case,d,expected);own+=cross
   if debug is not None:expected.tofile(debug/(name+'-CPU.bin'))
   checks.extend(dict(v,check=name+'/'+v['check']) for v in own);results.append(dict(case=name,status='PASSED' if all(v['passed'] for v in own) else 'FAILED',native=metrics,components=dict(weak=info['weak_components'],seeded=info['seeded_components']),checks=own))
 except Exception as error:checks.append(dict(check='complete-data-no-exception',passed=False,error=repr(error)))
 return dict(status='PASSED' if checks and all(c['passed'] is True for c in checks) else 'FAILED',checks=checks,case_count=len(results),cases=results)

ORIGINAL_CASES={'original-teapot','constant-zero','isoluminant-color-step','weak-step-with-strong-seed','independent-noise-983743'}
def validate_originals(runs,spec,language=None):
 checks=[];results=[];required=[dict(case=lang+'/'+name) for lang in ([language] if language else ['cpp','python']) for name in sorted(ORIGINAL_CASES)]
 rows=[r for r in runs if language is None or r['language']==language];checks.append(coverage([dict(case=r['language']+'/'+r['case']) for r in rows],required));by={c['case']:c for c in spec['cases']}
