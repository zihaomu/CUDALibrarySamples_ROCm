  for r in rows:
   name=r['language']+'/'+r['case'];case=by[r['case']];d=ROOT/case['fixture'];c=json.loads((d/'config.json').read_text());h,w=c['height'],c['width'];out=ROOT/r['outputs'];audit=ROOT/r['audit'];info=json.loads((audit/'workflow.json').read_text());expected,_=model(d);source=np.fromfile(d/'input.bin',np.uint8).reshape(h,c['pitch'])[:,:3*w].reshape(h,w,3);gray=cv2.Canny(cv2.cvtColor(source,cv2.COLOR_BGR2GRAY),50,100,L2gradient=True);channels=cv2.split(source);merged=cv2.bitwise_or(cv2.Canny(channels[0],50,100,L2gradient=True),cv2.bitwise_or(cv2.Canny(channels[1],50,100,L2gradient=True),cv2.Canny(channels[2],50,100,L2gradient=True)))
   own=[dict(check='actual-original-process-success',passed=r['return_code']==0),fixture_identity(d,case['manifest_sha256']),file_set(out,['edges_npp.png','edges_opencv_gray.png','edges_opencv_3ch.png']),file_set(audit,['input.bin','mask.bin','workflow.json']),array_check(audit/'input.bin',np.ascontiguousarray(source),digest(audit/'input.bin')),array_check(audit/'mask.bin',expected,digest(audit/'mask.bin'))]
   for filename,gold in [('edges_npp.png',expected),('edges_opencv_gray.png',gray),('edges_opencv_3ch.png',merged)]:
    actual=cv2.imread(str(out/filename),cv2.IMREAD_UNCHANGED);own.append(dict(check=filename+'/all-decoded-pixels',passed=actual is not None and actual.shape==gold.shape and actual.dtype==np.uint8 and np.array_equal(actual,gold)))
   ts=info['timings_ms'];own.append(dict(check='complete-original-timing-and-CPU-comparison-workflow',passed=info['width']==w and info['height']==h and info['warmup']==1 and info['iterations']==info['gray_iterations']==info['color_iterations']==10 and len(ts)==10 and all(math.isfinite(t) and t>0 for t in [*ts,info['gray_ms'],info['color_ms']]) and info['backend']=='Project HIP classical C3 Canny'))
   checks.extend(dict(v,check=name+'/'+v['check']) for v in own);results.append(dict(case=name,status='PASSED' if all(c['passed'] for c in own) else 'FAILED',checks=own))
 except Exception as error:checks.append(dict(check='complete-original-data-no-exception',passed=False,error=repr(error)))
 return dict(status='PASSED' if checks and all(c['passed'] is True for c in checks) else 'FAILED',checks=checks,case_count=len(results),cases=results)

