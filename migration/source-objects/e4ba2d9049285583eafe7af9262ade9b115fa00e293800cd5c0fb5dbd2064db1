def model(fixture):
 c=json.loads((fixture/'config.json').read_text());stages=reference(fixture);weak=stages['suppressed']>c['low'];strong=stages['suppressed']>c['high'];count,labels=cv2.connectedComponents(weak.astype(np.uint8),connectivity=8);keep=np.zeros(count,bool);keep[labels[strong]]=True;keep[0]=False
