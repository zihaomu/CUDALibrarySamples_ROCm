+#!/usr/bin/env python3
+"""Build the frozen I4 progressive JPEG GPU pixel-synthesis prototype."""
+import json
+from pathlib import Path
+
+from experiment import ROOT, Experiment, digest, write
+from image_progress import record
+from snapshot import capture
+
+SOURCE = ROOT / 'rocm/probes/image/jpeg_progressive_gpu.hip'
+HEADER = ROOT / 'rocm/common/image/progressive_jpeg.hpp'
+PROFILE = ROOT / 'migration/rewrite/image-progressive-gpu-profile.json'
+REPORT = ROOT / 'migration/reports/image-progressive-build.json'
+
+
+def main():
+    profile = json.loads(PROFILE.read_text())
+    if profile['status'] != 'FROZEN':
+        raise ValueError('frozen progressive profile required')
+    e = Experiment('I4', 'progressive-JPEG-HIP-IDCT-and-color-prototype',
+                   'rocm-build', sources=[__file__, SOURCE, HEADER, PROFILE],
+                   parent=Path(profile['evidence']).name)
+    write(e.path / 'backend.observed.json', capture())
+    core = Path('/opt/venv/lib/python3.13/site-packages/_rocm_sdk_core')
+    overlay = ROOT / 'build/rocm-sdk-overlay'
+    jpeg = ROOT / 'build/cpu-codecs'
+    jpeg_library = jpeg / 'lib/libjpeg.so.62.4.0'
+    if not (jpeg / 'include/jpeglib.h').is_file() or not jpeg_library.is_file():
+        raise ValueError('pinned private libjpeg-turbo dependency missing')
+    binary = e.path / 'progressive_gpu'
+    rc = e.command(['hipcc', '--rocm-path=' + str(overlay),
+        '--hip-path=' + str(overlay),
+        '--rocm-device-lib-path=' + str(core / 'lib/llvm/amdgcn/bitcode'),
+        '--offload-arch=gfx1201', '-std=c++17', '-O2', '-D__HIP_PLATFORM_AMD__',
+        '-I' + str(jpeg / 'include'), '-I' + str(HEADER.parent),
+        '-x', 'hip', str(SOURCE), '-L' + str(core / 'lib'),
+        '-L' + str(jpeg / 'lib'), '-Wl,-rpath,' + str(core / 'lib'),
+        '-Wl,-rpath,' + str(jpeg / 'lib'), '-lamdhip64', '-ljpeg',
+        '-o', str(binary)], 'build-progressive-GPU-IDCT', timeout=300)
+    result = dict(status='BUILT' if rc == 0 else 'BUILD_ERROR', return_code=rc,
+                  experiment_id=e.id, binary=str(binary.relative_to(ROOT)) if rc == 0 else None,
+                  binary_sha256=digest(binary) if rc == 0 else None,
+                  dependencies={str(p.relative_to(ROOT)): digest(p) for p in
+                                [SOURCE, HEADER, PROFILE, jpeg / 'include/jpeglib.h', jpeg_library]})
+    write(e.path / 'build.json', result)
+    result['evidence'] = e.finish('EXECUTED' if rc == 0 else 'BUILD_ERROR',
+        dict(status=result['status'], checks=[dict(check='HIP-prototype-build', passed=rc == 0)]))
+    write(REPORT, result)
+    record('I4', 'progressive JPEG CPU 熵解码 + HIP IDCT/色彩原型编译：' +
+           result['status'] + '；数值和 GPU trace 待验。', [result['evidence']])
+    print(result['status'], result['evidence'])
+    return int(rc != 0)
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
