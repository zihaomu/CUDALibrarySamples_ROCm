  "CLI": {
    "default_batch": 5,
    "valid_batch_counts": [
      1,
      2,
      3,
      4,
      5
    ],
    "original_partial_batch_bug": "Original later batch loops hardcode 5 after allocating only -b images. Project consistently processes requested 1..5 and rejects invalid counts before GPU initialization.",
    "errors": [
      "missing-b",
      "zero",
      "negative",
      "above-five",
      "noninteger",
      "duplicate",
      "unknown-option",
      "missing-input",
      "truncated-input",
      "unwritable-output",
      "no-GPU"
    ]
  },
  "GPU": "all pixel initialization, equality union/find, prefix-scan compaction and final labels on GPU; CPU may read scalar convergence flag and final component count",
  "runtime": [
    "nondefault-stream",
    "changed-input",
    "repeat",
    "independent-concurrent-instances",
    "pitched-input-and-output-padding",
    "heterogeneous-batch-and-tail",
    "undersized-device-buffers",
    "overlap-and-device-identity",
    "no-host-image-compute"
  ],
  "sources": [
    "https://docs.nvidia.com/cuda/nppplus/image_filtering_functions.html",
